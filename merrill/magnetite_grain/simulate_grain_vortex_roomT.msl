! MERRILL development version 2.X

! Setup material constants for Magnetite at 20
! Degrees Celsius
Material : Type = Magnetite, TempC =20

! Load mesh from tec file (can also be Patran)
Set: maxMeshNumber=1
ReadMesh: mesh=1, filename=../mesh/PLAG121.pat, FileType=patran
! ReadMesh: mesh=1, filename=../mesh/PLAG-50_origin.1_stl_NOMAG.tec, FileType=tecplot

! A vortex state
! Vortex axis=0;0;1 origin=0;0;0 strength=0.1 chirality=LH

! Uniform
Uniform Magnetization: axis=1;1;1

WriteMagnetization: filename=grainMag_initial

! Run the minimizer
Minimize

! Output the solution M to two files: soln.dat and
! soln_mult.tec
WriteMagnetization: filename=grainMag_final
